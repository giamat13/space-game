rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Per-player table entries (leaderboards). A player owns the document named after
    // their uid, plus any older document that carries their uid in `userId`.
    // Ownership must NOT depend only on a field inside the stored document: an empty or
    // damaged document has no such field and would then be impossible to repair.
    function ownsEntry(entryId) {
      return isSignedIn() &&
        (entryId == request.auth.uid ||
         entryId == request.auth.uid + '_alt' ||
         resource.data.get('userId', null) == request.auth.uid);
    }

    function writesOwnEntry() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if writesOwnEntry();
      allow update: if ownsEntry(entryId) && writesOwnEntry();
      allow delete: if ownsEntry(entryId);
    }

    match /scores/{skin}/entries/{entryId} {
      allow read: if true;
      allow create: if writesOwnEntry();
      allow update: if ownsEntry(entryId) && writesOwnEntry();
      allow delete: if ownsEntry(entryId);
    }

    match /userStats/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /moneyLeaderboard/{userId} {
      allow read: if true;
      allow create: if writesOwnEntry();
      allow update: if ownsEntry(userId) && writesOwnEntry();
      allow delete: if ownsEntry(userId);
    }

    // Education sessions: shared classroom state. Anonymous students use these
    // documents, so keep the existing access behavior for deployed clients.
    match /eduSessions/{sessionId} {
      allow read, write: if true;
      match /participants/{clientId} {
        allow read, write: if true;
      }
    }

    match /speedrun/{goalKey}/entries/{userId} {
      allow read: if true;
      allow create: if writesOwnEntry();
      allow update: if ownsEntry(userId) && writesOwnEntry();
      allow delete: if ownsEntry(userId);
    }

    match /game_sessions/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /coinTransfers/{transferId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toEmail == request.auth.token.email);
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.claimed == false &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update: if isSignedIn() &&
        resource.data.toEmail == request.auth.token.email &&
        resource.data.claimed == false &&
        request.resource.data.claimed == true &&
        request.resource.data.amount == resource.data.amount;
      allow delete: if false;
    }

    match /gameSessions/{sessionId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous');
      allow update, delete: if false;

      match /logs/{logId} {
        allow create: if true;
        allow read: if isSignedIn() && get(/databases/$(database)/documents/gameSessions/$(sessionId)).data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /userAnalytics/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}